{
  "name": "rea-city",
  "version": "1.0.0",
  "description": "类 GTA 开放城市原型（Three.js）",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-transform-types --no-warnings scripts/test/*.test.ts",
    "econ:sim": "node --import ./scripts/lib/ts-resolve.mjs scripts/test/econ-sim.ts",
    "casino:sim": "node scripts/casino-sim.ts",
    "ride:sim": "node --experimental-transform-types --no-warnings scripts/test/ride-sim.ts",
    "geo:download": "node scripts/geo/00-download.ts",
    "geo:extract": "node scripts/geo/01-extract.ts",
    "geo:project": "node scripts/geo/02-project.ts",
    "geo:roads": "node scripts/geo/03-roads.ts",
    "geo:buildings": "node scripts/geo/04-buildings.ts",
    "geo:all": "npm run geo:roads && npm run geo:buildings && npm run geo:landuse && npm run geo:props && npm run geo:pois && npm run geo:roadmesh && npm run geo:chunks",
    "geo:landuse": "node scripts/geo/05-landuse.ts",
    "geo:props": "node scripts/geo/06-props.ts",
    "geo:pois": "node scripts/geo/07-pois.ts",
    "geo:roadmesh": "node scripts/geo/08-roadmesh.ts",
    "geo:chunks": "node scripts/geo/09-chunks.ts",
    "geo:check": "node scripts/geo/check-clearance.ts",
    "char:build": "node scripts/char/build.ts",
    "props:build": "node scripts/props/build.ts",
    "lut:build": "node scripts/lut/build.ts",
    "deploy:cf": "npm run build && wrangler deploy",
    "i18n:check": "node scripts/i18n-check.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "csv-parse": "^7.0.3",
    "earcut": "^3.2.4",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module"
}
