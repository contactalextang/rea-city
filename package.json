    "preview": "vite preview --port 4173",
    "check": "tsc --noEmit",
    "geo:download": "node scripts/geo/00-download.ts",
    "geo:extract": "node scripts/geo/01-extract.ts",
    "geo:project": "node scripts/geo/02-project.ts",
    "geo:roads": "node scripts/geo/03-roads.ts",
    "geo:buildings": "node scripts/geo/04-buildings.ts",
    "geo:all": "npm run geo:download && npm run geo:extract && npm run geo:project"
  },
