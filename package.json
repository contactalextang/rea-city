    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "csv-parse": "^7.0.3",
    "earcut": "^3.2.4",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
