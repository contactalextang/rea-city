// Cloudflare Workers 部署配置：目前是纯静态资源（不写 main，请求不经过 Worker 代码、不计费）。
// 以后加账号 / 云存档时在这里补 main + run_worker_first + D1 绑定，设计见 docs/ACCOUNTS.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rea-city",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "rea.alextang.dev", "custom_domain": true }]
}
